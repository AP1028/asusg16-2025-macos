     children->release();
 
+    // ---- DSH fallback: locate the touchpad device outside the I2C scope ----
+    // macOS does not create injected ACPI devices beneath an I2C controller node
+    // (_SB.PC00.I2C3 has no children, and six controlled attempts to add one all
+    // failed), whereas the identical device publishes fine under _SB.PC00.
+    // Without this, no VoodooI2CDeviceNub is ever created for this machine.
+    if (device_nubs->getCount() == 0 && dsh_tried == false) {
+        dsh_tried = true;
+        // Search the ACPI plane recursively: fromPath() proved unreliable from this
+        // context, and a non-recursive scan only sees C000..C0xx/_SB/THRM at the top.
+        IORegistryEntry *root = IORegistryEntry::getRegistryRoot();
+        IORegistryEntry *acpi = root ? root->getChildEntry(gIOACPIPlane) : nullptr;
+        IORegistryEntry *dev = DshFindAcpi("ZTPD", acpi, 0);
+
+        if (dev) {
+            IOLog("%s::%s DSH: located ZTPD, creating nub\n", getName(), bus_device.name);
+            VoodooI2CDeviceNub *device_nub = OSTypeAlloc(VoodooI2CDeviceNub);
+            OSDictionary *child_properties = dev->dictionaryWithProperties();
+
+            // The HID personality matches on  IOPropertyMatch = { compatible = PNP0C50 }.
+            // In the normal path that property arrives because the child is a real
+            // ACPI-plane device and Apple's ACPI layer publishes _HID/_CID as
+            // "compatible". Our synthesised ZTPD does not carry it, so the HID
+            // personality has never been matchable on this machine -- which is
+            // exactly why DshHIDDevice instances have always been 0 with no
+            // diagnostics at all (never a failed start; simply never considered).
+            //
+            // Publish diagnostics first so we can SEE what the device actually
+            // offers rather than assume, then set compatible defensively.
+            if (device_nub) {
+                OSObject *compat = dev ? dev->copyProperty("compatible") : NULL;
+                if (compat) {
+                    device_nub->setProperty("compatible", compat);
+                    compat->release();
+                } else {
+                    device_nub->setProperty("compatible", "PNP0C50");
+                }
+            }
+
+            if (!device_nub ||
+                !device_nub->init(child_properties) ||
+                !device_nub->attach(this, OSDynamicCast(IOService, dev))) {
+                IOLog("%s::%s DSH: could not initialise nub\n", getName(), bus_device.name);
+            } else if (!device_nub->start(this)) {
+                device_nub->detach(this);
+                IOLog("%s::%s DSH: could not start nub\n", getName(), bus_device.name);
+            } else {
+                device_nubs->setObject(device_nub);
+                IOLog("%s::%s DSH: touchpad nub published\n", getName(), bus_device.name);
+            }
+            OSSafeReleaseNULL(child_properties);
+            OSSafeReleaseNULL(device_nub);
+        }
+    }
+
     return kIOReturnSuccess;
 }
 

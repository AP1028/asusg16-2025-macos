+// One-shot guard for the DSH device-lookup fallback.
+static bool dsh_tried = false;
+
+// Recursively locate an ACPI device by name. fromPath() proved unreliable from this
+// context, and the ACPI plane's top level only holds C000..C0xx, _SB and THRM, so a
+// non-recursive scan never reaches _SB/PC00/ZTPD.
+static IORegistryEntry *DshFindAcpi(const char *want, IORegistryEntry *node, int depth)
+{
+    if (!node || depth > 6) return nullptr;
+    OSIterator *it = node->getChildIterator(gIOACPIPlane);
+    if (!it) return nullptr;
+    IORegistryEntry *o, *found = nullptr;
+    while (!found && (o = OSDynamicCast(IORegistryEntry, it->getNextObject()))) {
+        const char *nm = o->getName();
+        if (nm && strncmp(nm, want, 4) == 0) { found = o; break; }
+        found = DshFindAcpi(want, o, depth + 1);
+    }
+    it->release();
+    return found;
+}

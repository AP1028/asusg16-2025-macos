+    /*
+     * REPORT LENGTH FIX. The I2C-HID frame is [2-byte length][payload],
+     * so the payload is (return_size - 2) bytes. This allocated a descriptor of
+     * return_size but filled only return_size - 2, handing macOS a report 2 bytes
+     * LONGER than the device sent, with two uninitialised trailing bytes that the HID
+     * parser then reads as report data. Linux passes exactly the payload length:
+     *     hid_safe_input_report(hid, 0, inbuf + 2, length - 2, 1)
+     */
+    buffer = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, 0,
+                                                         (return_size >= 2) ? (UInt32)(return_size - 2) : 0);
